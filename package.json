{
  "name": "dog-photo-mask",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "copy-mediapipe-wasm": "node scripts/copy-mediapipe-wasm.js",
    "dev": "pnpm run copy-mediapipe-wasm && vite",
    "build": "pnpm run copy-mediapipe-wasm && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm wrangler deploy",
    "cloudflare:preview": "pnpm wrangler preview",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "prettier --write --log-level=warn .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "pnpm run copy-mediapipe-wasm",
    "test": "vitest run",
    "test:ui": "pnpm run copy-mediapipe-wasm && vitest --ui --coverage",
    "coverage": "pnpm run copy-mediapipe-wasm && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "@sentry/react": "^11.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "konva": "^10.9.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-konva": "^19.3.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^11.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.156.2"
  }
}
